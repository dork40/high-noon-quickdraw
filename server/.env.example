PORT=8080
# Comma-separated browser origins. Do not use * in production.
ALLOWED_ORIGINS=https://your-game.example
# A high-entropy secret shared only with coturn for TURN REST credentials.
TURN_SHARED_SECRET=replace-with-a-long-random-secret
TURN_URLS=turn:turn.example:3478?transport=udp,turns:turn.example:5349?transport=tcp
TURN_TTL_SECONDS=600
# Service-to-service proof of an authenticated player. Never put this in Vite/browser variables.
TURN_ISSUER_TOKEN=replace-with-a-second-long-random-secret
