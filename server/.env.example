PORT=8080
# Comma-separated exact browser origins, including scheme and no trailing slash.
# Wildcards are not supported.
ALLOWED_ORIGINS=https://your-game.example
# A high-entropy secret shared only with coturn for TURN REST credentials.
TURN_SHARED_SECRET=replace-with-a-long-random-secret
TURN_URLS=turn:turn.example:3478?transport=udp,turns:turn.example:5349?transport=tcp
TURN_TTL_SECONDS=600
# A high-entropy secret shared only with the trusted service that issues 15-minute
# signed TURN tickets. Never put this value in Vite/browser variables.
TURN_TICKET_SECRET=replace-with-a-second-long-random-secret
