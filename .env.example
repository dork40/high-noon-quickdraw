VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Optional HTTPS authority service. It is used only for short-lived authenticated TURN credentials.
# Never add a TURN secret or ticket as a VITE_ variable; see server/README.md.
VITE_AUTHORITY_URL=https://authority.your-domain.example
